## From 'graphics'
exportMethods(image)

## From 'methods'
exportMethods(Arith, Compare, Logic, Math, Math2, Ops, Summary,
              cbind2, coerce, rbind2, show)

## From 'stats'
exportMethods(cov2cor, toeplitz, update)

## From 'utils'
exportMethods(head, tail)


